<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (ws://) for gateway connections and localhost MCP.
         The kelvin-tc self-signed cert is NOT trusted here (doing so app-wide would let
         a leaked kelvin key MITM unrelated channels). wss://:443 trust is scoped to the
         gateway OkHttpClient only, via a custom TrustManager + SPKI pin in GatewayTls. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
