    <color name="code_block_text">#E5E7EB</color>
    <color name="quick_send_bg">#14301A</color>
    <color name="quick_send_text">#A7F3D0</color>
    <color name="icon_accent">#7AA2FF</color>
    <color name="remote_header_bg">#1F1F1F</color>
    <color name="remote_openclaw_bg">#1F1416</color>

    <!-- Header (action bar + status bar): dark bar with light content -->
    <color name="header_bg">#1F1F1F</color>
    <color name="header_content">#E5E7EB</color>
</resources>
